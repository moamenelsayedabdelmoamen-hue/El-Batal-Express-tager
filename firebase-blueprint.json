{
  "entities": {
    "Merchant": {
      "title": "Merchant",
      "description": "Authorized merchant account for restaurant owners in El Batal Express",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication User ID"
        },
        "name": {
          "type": "string",
          "description": "Merchant business or owner display name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google email of the merchant"
        },
        "logo": {
          "type": "string",
          "description": "Merchant logo image URL in Firebase Storage"
        },
        "photoUrl": {
          "type": "string",
          "description": "Avatar or profile image URL"
        },
        "phone": {
          "type": "string",
          "description": "Contact telephone number"
        },
        "address": {
          "type": "string",
          "description": "Merchant physical address"
        },
        "category": {
          "type": "string",
          "enum": ["مطعم", "صيدلية", "سوبر ماركت", "خضار", "كافيه", "جزارة", "أكل حيوانات"],
          "description": "Merchant store category selected during registration"
        },
        "accountType": {
          "type": "string",
          "enum": ["merchant"],
          "description": "Strict account type discriminator identifying merchants"
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Mirrors Firebase Auth email verification state after reload()"
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["unsubscribed", "active", "suspended", "cancelled", "expired", "payment_failed"],
          "description": "Current subscription plan status"
        },
        "status": {
          "type": "string",
          "enum": ["approved", "pending", "rejected"],
          "description": "Administrative approval status"
        },
        "isApproved": {
          "type": "boolean",
          "description": "True if merchant account is active and approved by administration"
        },
        "role": {
          "type": "string",
          "enum": ["merchant"],
          "description": "Role identifier"
        },
        "authProvider": {
          "type": "string",
          "description": "Authentication provider e.g. password or google.com"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of most recent login"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["uid", "email", "accountType"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Canonical server-managed merchant subscription document stored at subscriptions/{merchantId}",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["unsubscribed", "active", "suspended", "cancelled", "expired", "payment_failed"]
        },
        "isSubscribed": { "type": "boolean" },
        "planId": { "type": "integer" },
        "planName": { "type": "string" },
        "maxCaptains": { "type": "integer" },
        "price": { "type": "integer" },
        "paymentStatus": { "type": "string" },
        "suspensionReason": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["merchantId", "status", "isSubscribed"]
    },
    "Order": {
      "title": "Order",
      "description": "Courier dispatch orders",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "captainId": { "type": "string" },
        "status": { "type": "string" },
        "dispatchStatus": { "type": "string" }
      }
    },
    "Captain": {
      "title": "Captain",
      "description": "Delivery captain profile and availability",
      "type": "object",
      "properties": {
        "captainId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "isOnline": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/merchants/{merchantId}": {
      "schema": "Merchant",
      "description": "Merchant accounts pre-registered and approved by El Batal Express"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "Canonical merchant subscription documents keyed by merchantId"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders created by merchants"
    },
    "/captains/{captainId}": {
      "schema": "Captain",
      "description": "Delivery captains registered in the system"
    }
  }
}
