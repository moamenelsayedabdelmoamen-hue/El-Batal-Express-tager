{
  "name": "el-batal-functions",
  "version": "1.0.0",
  "description": "Smart Auto Dispatch Backend for El-Batal Express",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "private": true,
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true
  },
  "overrides": {
    "@firebase/database-compat": "2.1.7"
  }
}
