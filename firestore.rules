rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user has admin privileges via Custom Claims, verified email whitelist, or admins collection
    function isAdmin() {
      return isSignedIn() && (
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('email' in request.auth.token &&
          request.auth.token.email in ['moamen.elsayed.abdelmoamen@gmail.com', 'admin@elbatalexpress.com'] &&
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    // Strict role/collection isolation helpers
    function hasCaptainAccount(uid) {
      return exists(/databases/$(database)/documents/captains/$(uid));
    }

    function hasMerchantAccount(uid) {
      return exists(/databases/$(database)/documents/merchants/$(uid));
    }

    function isMerchantAccount() {
      let merch = get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data;
      return isSignedIn() &&
        hasMerchantAccount(request.auth.uid) &&
        !hasCaptainAccount(request.auth.uid) &&
        (merch.accountType == 'merchant' || (!('accountType' in merch) && merch.role == 'merchant'));
    }

    function isMerchant(merchantId) {
      return isSignedIn() && (
        request.auth.uid == merchantId ||
        (request.auth.token.role == 'merchant' && request.auth.token.merchantId == merchantId)
      );
    }

    function isUnexpiredEndDate(val) {
      return val == null ||
        (val is timestamp && val > request.time) ||
        (val is int && (
          (val >= 1000000000000 && val > request.time.toMillis()) ||
          (val > 0 && val < 1000000000000 && (val * 1000) > request.time.toMillis())
        ));
    }

    function isActiveStatusValue(val) {
      return val in ['active', 'activated', 'subscribed', 'enabled', 'نشط', 'نشطة', 'ساري', 'سارية', 'فعال', 'فعّال', 'مفعل', 'مفعّل'];
    }

    function hasPositiveCaptainLimit(doc) {
      return ('captainLimit' in doc && doc.captainLimit > 0) ||
        ('maxCaptains' in doc && doc.maxCaptains > 0) ||
        (!('captainLimit' in doc) && !('maxCaptains' in doc) && 'planId' in doc && doc.planId > 0);
    }

    function isNotExplicitlyDeactivated(doc) {
      return !('isActive' in doc && doc.isActive == false && (!('isSubscribed' in doc) || doc.isSubscribed != true));
    }

    function isSubscriptionDocActive(subData) {
      return (
          ('status' in subData && isActiveStatusValue(subData.status)) ||
          ('subscriptionStatus' in subData && isActiveStatusValue(subData.subscriptionStatus))
        ) &&
        isNotExplicitlyDeactivated(subData) &&
        hasPositiveCaptainLimit(subData) &&
        (!('endDate' in subData) || isUnexpiredEndDate(subData.endDate)) &&
        (!('expiresAt' in subData) || isUnexpiredEndDate(subData.expiresAt));
    }

    // Server-side authoritative subscription check across BOTH subscriptions/{uid} and merchants/{uid}
    function hasActiveMerchantSubscription(uid) {
      let merch = get(/databases/$(database)/documents/merchants/$(uid)).data;
      let isMerchDoc = merch.accountType == 'merchant' || (!('accountType' in merch) && merch.role == 'merchant');
      return isMerchDoc &&
        merch.status in ['approved', 'active'] &&
        !('subscriptionStatus' in merch && merch.subscriptionStatus in ['suspended', 'inactive', 'cancelled', 'canceled', 'expired', 'pending', 'pending_review', 'rejected', 'resubmission_required', 'pending_payment', 'payment_failed']) &&
        (
          exists(/databases/$(database)/documents/subscriptions/$(uid))
            ? isSubscriptionDocActive(get(/databases/$(database)/documents/subscriptions/$(uid)).data)
            : (
                'subscriptionStatus' in merch &&
                isActiveStatusValue(merch.subscriptionStatus) &&
                isNotExplicitlyDeactivated(merch) &&
                hasPositiveCaptainLimit(merch) &&
                (!('subscriptionEndDate' in merch) || isUnexpiredEndDate(merch.subscriptionEndDate)) &&
                (!('expiresAt' in merch) || isUnexpiredEndDate(merch.expiresAt))
              )
        );
    }
    
    // Check if user is the captain
    function isCaptain(captainId) {
      return isSignedIn() && (
        (request.auth.token.role == 'captain' && request.auth.token.captainId == captainId) ||
        request.auth.uid == captainId
      );
    }

    // Default deny for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection: only admins can read or manage
    match /admins/{adminId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Merchants collection:
    // Strictly isolated to merchant accounts (`accountType == 'merchant'`).
    // Blocked if UID already belongs to a captain account.
    match /merchants/{merchantId} {
      allow get: if isAdmin() || (isMerchant(merchantId) && !hasCaptainAccount(request.auth.uid));
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == merchantId && !hasCaptainAccount(request.auth.uid)
        && request.resource.data.uid == merchantId
        && request.resource.data.accountType == 'merchant'
        && request.resource.data.role == 'merchant'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 150
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 32
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 300
        && request.resource.data.emailVerified == false
        && request.resource.data.status == 'pending'
        && request.resource.data.subscriptionStatus == 'unsubscribed'
        && request.resource.data.isSubscribed == false
        && request.resource.data.maxCaptains == 0
        && request.resource.data.planId == 0
        && !('isApproved' in request.resource.data)
        && !('isAdmin' in request.resource.data)
        && !('walletBalance' in request.resource.data)
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'address', 'category', 'logo', 'photoUrl',
          'logoUrl', 'storagePath', 'accountType', 'role', 'emailVerified', 'status',
          'isSubscribed', 'subscriptionStatus', 'maxCaptains', 'planId', 'authProvider',
          'createdAt', 'updatedAt'
        ])
      );
      allow update: if isAdmin() || (
        isMerchant(merchantId) && !hasCaptainAccount(request.auth.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.accountType == 'merchant'
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && (!('isApproved' in resource.data) || request.resource.data.isApproved == resource.data.isApproved)
        && !('isApproved' in request.resource.data.diff(resource.data).affectedKeys())
        && !('status' in request.resource.data.diff(resource.data).affectedKeys())
        && request.resource.data.email == resource.data.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 150
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 32
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 300
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'address', 'category', 'description', 'logo', 'logoUrl',
          'photoUrl', 'imageUrl', 'storagePath', 'location', 'latitude', 'longitude',
          'locationUrl', 'locationLink', 'mapUrl', 'mapLink', 'mapsUrl', 'mapsLink',
          'googleMapsUrl', 'googleMapUrl', 'isOpen', 'workingHours', 'fcmToken',
          'emailVerified', 'lastLoginAt', 'updatedAt'
        ])
        && (!('emailVerified' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.emailVerified == false
          || request.auth.token.email_verified == true)
      );
      allow delete: if isAdmin();
      match /{subcollection}/{subDoc=**} {
        allow read: if isAdmin() || (isMerchant(merchantId) && !hasCaptainAccount(request.auth.uid));
        allow write: if isAdmin();
      }
    }

    // Captains: private by default. Merchants can get only the captain currently assigned to them.
    match /captains/{captainId} {
      allow get: if isAdmin()
        || isCaptain(captainId)
        || (
          isSignedIn()
          && hasMerchantAccount(request.auth.uid)
          && (
            ('activeMerchantId' in resource.data && resource.data.activeMerchantId == request.auth.uid)
            || ('currentMerchantId' in resource.data && resource.data.currentMerchantId == request.auth.uid)
          )
        );
      allow list: if isAdmin();

      allow create: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == captainId
        && !hasMerchantAccount(request.auth.uid)
        && request.resource.data.uid == captainId
        && request.resource.data.role == 'captain'
        && request.resource.data.status == 'pending'
        && request.resource.data.walletBalance == 0
        && !('isAdmin' in request.resource.data)
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'fullName', 'driver_name', 'phone', 'phoneNumber', 'email',
          'role', 'status', 'profileImagePath', 'idFrontImagePath', 'idBackImagePath',
          'licenseImagePath', 'idDocumentsComplete', 'rating', 'walletBalance',
          'vehicleType', 'licensePlate', 'createdAt', 'updatedAt', 'avatarUri', 'profileImageUrl', 'photoUrl',
          'idCardImageUrl', 'licenseImageUrl', 'nationalIdUrl', 'licenseUrl',
          'avatarPresetIndex', 'isOnline', 'isLoggedIn', 'emailVerified', 'isEmailVerified'
        ])
      );

      allow update: if isAdmin() || (
        isCaptain(captainId)
        && !hasMerchantAccount(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'fullName', 'driver_name', 'phone', 'phoneNumber', 'emailVerified',
          'isEmailVerified', 'isLoggedIn', 'isOnline', 'presenceStatus', 'location',
          'latitude', 'longitude', 'accuracy', 'bearing', 'speed', 'lastLocationUpdate',
          'lastLocationTimestamp', 'updatedAt', 'profileImagePath', 'profileImageUpdatedAt', 'profileImageUrl', 'photoUrl', 'avatarUri',
          'idFrontImagePath', 'idBackImagePath', 'licenseImagePath', 'idDocumentsComplete',
          'idCardImageUrl', 'licenseImageUrl', 'nationalIdUrl', 'licenseUrl',
          'vehicleType', 'licensePlate', 'avatarUri', 'avatarPresetIndex', 'fcmToken'
        ])
      );
      allow delete: if isAdmin();

      match /transactions/{transactionId} {
        allow get, list: if isAdmin() || (isSignedIn() && request.auth.uid == captainId);
        allow create, update, delete: if isAdmin();
      }
      match /daily_wallets/{dayKey} {
        allow get, list: if isAdmin() || (isSignedIn() && request.auth.uid == captainId);
        allow create, update, delete: if isAdmin();
      }
      match /subscriptions/{subscriptionId} {
        allow get, list: if isAdmin() || (isSignedIn() && request.auth.uid == captainId);
        allow create, update, delete: if isAdmin();
      }
      match /shifts/{shiftId} {
        allow get, list: if isAdmin() || (isSignedIn() && request.auth.uid == captainId);
        allow create, update, delete: if isAdmin();
      }
    }

    // Captain schedules are managed by admins; captains can read only their own schedules.
    match /captain_schedules/{scheduleId} {
      allow get: if isAdmin() || (isSignedIn() && (
        request.auth.uid == scheduleId ||
        ('captainId' in resource.data && resource.data.captainId == request.auth.uid) ||
        ('captainUid' in resource.data && resource.data.captainUid == request.auth.uid) ||
        ('driverId' in resource.data && resource.data.driverId == request.auth.uid)
      ));
      allow list: if isAdmin() || (isSignedIn() && (
        ('captainId' in resource.data && resource.data.captainId == request.auth.uid) ||
        ('captainUid' in resource.data && resource.data.captainUid == request.auth.uid) ||
        ('driverId' in resource.data && resource.data.driverId == request.auth.uid)
      ));
      allow create, update, delete: if isAdmin();

      match /shifts/{shiftId} {
        allow read: if isAdmin() || isSignedIn() && request.auth.uid == scheduleId;
        allow write: if isAdmin();
      }
    }

    // Legacy shifts are read-only for the assigned captain; all schedule writes go through the admin panel.
    match /shifts/{shiftId} {
      allow get, list: if isAdmin() || (isSignedIn() && (
        ('captainId' in resource.data && resource.data.captainId == request.auth.uid) ||
        ('captainUid' in resource.data && resource.data.captainUid == request.auth.uid) ||
        ('driverId' in resource.data && resource.data.driverId == request.auth.uid)
      ));
      allow create, update, delete: if isAdmin();
    }

    // Orders collection:
    // 1. Direct client creation is STRICTLY BLOCKED: all new orders MUST go through trusted Cloud Functions
    //    (`requestCaptains` / `createOrderWithCode`) which enforce subscription, email verification, and atomic captainLimit.
    // 2. Merchants can read & follow their own orders, confirm/reject customer details, rate, or cancel —
    //    NEVER modify captain assignment, dispatch lease, capacity fields, or financial/settlement fields once assigned.
    // 3. Assigned captains retain full read & delivery status update capabilities without touching financial or ownership fields.
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (isMerchantAccount() && (
          resource.data.merchantId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.restaurantId == request.auth.uid
        )) ||
        (hasCaptainAccount(request.auth.uid) && (
          ('captainId' in resource.data && resource.data.captainId == request.auth.uid) ||
          ('offeredCaptainId' in resource.data && resource.data.offeredCaptainId == request.auth.uid)
        ));

      // All order creation, assignment, status, confirmation and settlement writes
      // are executed by the Dashboard Cloud Functions using the Admin SDK.
      allow create, delete: if isAdmin();

      // Merchant feedback is the only direct merchant write permitted on an order.
      // Status, dispatch, delivery confirmation, fees and settlement remain server-only.
      allow update: if isAdmin() || (
        isMerchantAccount() &&
        (resource.data.merchantId == request.auth.uid ||
         resource.data.userId == request.auth.uid ||
         resource.data.restaurantId == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratedAt']) &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5
      );
    }
    // Subscriptions collection:
    // Canonical document path: subscriptions/{merchantId}.
    // Merchant can ONLY read their own subscription document; never list other merchants or self-modify.
    match /subscriptions/{subscriptionId} {
      allow get: if isAdmin() || (
        isSignedIn() &&
        request.auth.token.email_verified == true &&
        subscriptionId == request.auth.uid &&
        !hasCaptainAccount(request.auth.uid)
      );
      allow list: if isAdmin();
      // Subscription activation, suspension, cancellation, and extension are strictly server/Admin-only.
      allow create, update, delete: if isAdmin();
    }

    // Manual Vodafone Cash Subscription Requests collection:
    // Created exclusively by trusted Cloud Function `submitManualSubscriptionRequest` (Admin SDK).
    // Reviewed/approved/rejected exclusively by Admins via `adminReviewManualSubscriptionRequest` / `adminUpdateMerchantSubscription`.
    match /subscription_requests/{requestId} {
      allow get, list: if isAdmin() || (
        isSignedIn() &&
        request.auth.token.email_verified == true &&
        !hasCaptainAccount(request.auth.uid) &&
        resource != null &&
        resource.data.merchantId == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
    }

    // Order Codes collection:
    // Exclusively written by trusted Cloud Functions / Admin SDK during atomic order creation.
    match /order_codes/{code} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        resource != null &&
        resource.data.merchantId == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
    }

    // Idempotency keys collection:
    // Exclusively written by trusted Cloud Functions / Admin SDK to prevent duplicate order creation on retries.
    match /idempotency_keys/{keyId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        resource != null &&
        (resource.data.merchantId == request.auth.uid || resource.data.userId == request.auth.uid)
      );
      allow create, update, delete: if isAdmin();
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read: if isAdmin() || 
        (isSignedIn() && (resource.data.merchantId == request.auth.uid));
      allow write: if isAdmin();
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Operation logs collection (server-side Cloud Functions audit trail)
    match /operation_logs/{logId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Users collection (used for user profile synchronization)
    match /users/{userId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }
  }
}
