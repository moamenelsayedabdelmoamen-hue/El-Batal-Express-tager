rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user has admin privileges via Custom Claims, email whitelist, or admins collection
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.email in ['moamen.elsayed.abdelmoamen@gmail.com', 'admin@elbatalexpress.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    // Strict role/collection isolation helpers
    function hasCaptainAccount(uid) {
      return exists(/databases/$(database)/documents/captains/$(uid));
    }

    function hasMerchantAccount(uid) {
      return exists(/databases/$(database)/documents/merchants/$(uid));
    }

    function hasRestaurantAccount(uid) {
      return exists(/databases/$(database)/documents/restaurants/$(uid));
    }

    // Check if user is the restaurant owner (strictly isolated from merchants and captains)
    function isRestaurantOwner(restaurantId) {
      return isSignedIn() && (
        (request.auth.token.role == 'restaurant' && request.auth.token.restaurantId == restaurantId) ||
        request.auth.uid == restaurantId
      );
    }

    // Check if user is the merchant owner (strictly isolated: NEVER includes isRestaurantOwner)
    function isMerchant(merchantId) {
      return isSignedIn() && (
        request.auth.uid == merchantId ||
        (request.auth.token.role == 'merchant' && request.auth.token.merchantId == merchantId)
      );
    }
    
    // Check if user is the captain
    function isCaptain(captainId) {
      return isSignedIn() && (
        (request.auth.token.role == 'captain' && request.auth.token.captainId == captainId) ||
        request.auth.uid == captainId
      );
    }

    // Default deny for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection: only admins can read or manage
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Merchants collection:
    // Strictly isolated to merchant accounts (`accountType == 'merchant'`).
    // Blocked if UID already belongs to captains or restaurants.
    match /merchants/{merchantId} {
      // Direct document read allowed for Admin or the merchant themselves (never a captain account)
      allow get: if isAdmin() || (
        isMerchant(merchantId) &&
        !hasCaptainAccount(request.auth.uid)
      );

      // Listing/scraping all merchants is restricted to admins only
      allow list: if isAdmin();

      // Creation allowed ONLY for admin or the authenticated user creating their own merchants/{uid}
      // with accountType == 'merchant', and NOT present in captains or restaurants
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == merchantId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.accountType == 'merchant' &&
        !hasCaptainAccount(request.auth.uid) &&
        !hasRestaurantAccount(request.auth.uid)
      );

      // Updating: Admin has full access. Merchant can update their profile info,
      // but cannot elevate or alter protected administrative/identity fields.
      allow update: if isAdmin() || (
        isMerchant(merchantId) &&
        !hasCaptainAccount(request.auth.uid) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) &&
        (!('isApproved' in request.resource.data) || request.resource.data.isApproved == resource.data.isApproved) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('accountType' in request.resource.data) || request.resource.data.accountType == 'merchant') &&
        (!('emailVerified' in request.resource.data) ||
          request.resource.data.emailVerified == resource.data.emailVerified ||
          (request.resource.data.emailVerified == true && request.auth.token.email_verified == true)) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid || request.resource.data.uid == request.auth.uid)
      );

      // Only admins can delete a merchant document
      allow delete: if isAdmin();

      // Subcollections under merchant (e.g., products, branches)
      match /{subcollection=**} {
        allow read, write: if isAdmin() || (isMerchant(merchantId) && !hasCaptainAccount(request.auth.uid));
      }
    }

    // Restaurants collection:
    // Strictly separated from merchants and captains
    match /restaurants/{restaurantId} {
      // Direct document read allowed for Admin or the restaurant owner (only if not a merchant/captain)
      allow get: if isAdmin() || (
        isRestaurantOwner(restaurantId) &&
        !hasMerchantAccount(request.auth.uid) &&
        !hasCaptainAccount(request.auth.uid)
      );
      
      // Listing/scraping all restaurants is restricted to admins only
      allow list: if isAdmin();

      // Creation blocked if user already exists in merchants or captains
      allow create: if isAdmin() || (
        isRestaurantOwner(restaurantId) &&
        !hasMerchantAccount(request.auth.uid) &&
        !hasCaptainAccount(request.auth.uid) &&
        (!('ownerId' in request.resource.data) || request.resource.data.ownerId == request.auth.uid) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
      );

      // Updating: Admin has full access. Restaurant owner can update own doc only if not merchant/captain.
      allow update: if isAdmin() || (
        isRestaurantOwner(restaurantId) &&
        !hasMerchantAccount(request.auth.uid) &&
        !hasCaptainAccount(request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'rating',
          'ratingCount'
        ]) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid || (!('uid' in resource.data) && request.resource.data.uid == request.auth.uid)) &&
        (!('ownerId' in request.resource.data) || request.resource.data.ownerId == resource.data.ownerId || (!('ownerId' in resource.data) && request.resource.data.ownerId == request.auth.uid)) &&
        (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt || !('createdAt' in resource.data))
      );

      // Only admins can delete a restaurant document
      allow delete: if isAdmin();
      
      // Subcollections under restaurant (e.g., menu, branches)
      match /{subcollection=**} {
        allow read, write: if isAdmin() || (
          isRestaurantOwner(restaurantId) &&
          !hasMerchantAccount(request.auth.uid) &&
          !hasCaptainAccount(request.auth.uid)
        );
      }
    }

    // Captains collection
    // Merchants and restaurants are strictly forbidden from creating or editing captain profiles.
    match /captains/{captainId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == captainId &&
        !hasMerchantAccount(request.auth.uid) &&
        !hasRestaurantAccount(request.auth.uid)
      );
      // Captains can update their own profile/status (blocked for merchants/restaurants).
      // Active order dispatch can update availabilityStatus and currentOrderId only.
      allow update: if isAdmin() || (
        isCaptain(captainId) &&
        !hasMerchantAccount(request.auth.uid) &&
        !hasRestaurantAccount(request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status',
          'rating',
          'ratingCount',
          'role'
        ])
      ) || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availabilityStatus',
          'currentOrderId',
          'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // Orders collection:
    // 1. Restaurant/Merchant can NEVER choose or modify captainId.
    // 2. Initial order creation must have captainId == null, dispatchStatus == 'searching', status == 'pending'.
    // 3. Selection and assignment are handled atomically by Cloud Functions / backend transactions.
    match /orders/{orderId} {
      allow read: if isAdmin() || 
        (isSignedIn() && (
          resource.data.restaurantId == request.auth.uid ||
          resource.data.merchantId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )) ||
        (isSignedIn() && (
          resource.data.captainId == request.auth.token.captainId ||
          resource.data.captainId == request.auth.uid
        ));
      
      // Restaurant/Merchant creates order with pending status and null captainId
      allow create: if isAdmin() || (
        isSignedIn() &&
        (request.request.resource.data.merchantId == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
        request.resource.data.captainId == null &&
        request.resource.data.dispatchStatus == 'searching' &&
        request.resource.data.status in ['pending', 'جاري البحث', 'جاري البحث عن كابتن']
      );

      // Restaurant/Merchant can update order details or cancel prior to assignment, but CANNOT set captainId or dispatchStatus
      // Captain can update delivery progress once assigned
      allow update: if isAdmin() || 
        (isSignedIn() && (resource.data.merchantId == request.auth.uid || resource.data.userId == request.auth.uid) &&
          request.resource.data.captainId == resource.data.captainId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['captainId', 'dispatchStatus', 'assignedAt'])
        ) ||
        (isSignedIn() && (resource.data.captainId == request.auth.uid) &&
          request.resource.data.captainId == resource.data.captainId
        );

      allow delete: if isAdmin();
    }

    // Subscriptions collection:
    // Merchant can read their own subscription document.
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (
        isSignedIn() && (
          subscriptionId == request.auth.uid ||
          request.resource.data.merchantId == request.auth.uid ||
          request.resource.data.restaurantId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    // Order Codes collection:
    // Tracks unique 6-digit codes. Allows authenticated merchants to atomically reserve codes during order creation.
    match /order_codes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.merchantId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // Idempotency keys collection:
    // Prevents duplicate order creation on network retries.
    match /idempotency_keys/{keyId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.merchantId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.merchantId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read: if isAdmin() || 
        (isSignedIn() && (resource.data.merchantId == request.auth.uid));
      allow write: if isAdmin();
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users collection (used for user profile synchronization)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
  }
}
